{
	email {$HARNESS_EMAIL}
}

{$HARNESS_DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api-server:8000 {
			flush_interval -1
			transport http {
				read_timeout 1h
				write_timeout 1h
				response_header_timeout 1m
			}
		}
	}

	handle /assets/* {
		reverse_proxy static-assets:80
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle /health {
		reverse_proxy api-server:8000
	}

	handle {
		reverse_proxy agent-console:80
	}
}
