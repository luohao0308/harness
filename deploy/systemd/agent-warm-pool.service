[Unit]
Description=Agent Harness WarmPool Service
After=network-online.target docker.service redis.service postgresql.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/agent-harness/services/api-server
EnvironmentFile=-/etc/agent-harness/api.env
ExecStart=/opt/agent-harness/services/api-server/.venv/bin/python -c "from app.sandbox.warm_pool import WarmPoolManager; WarmPoolManager().prewarm(); import time; time.sleep(86400)"
Restart=always
RestartSec=5
User=agent-harness
Group=agent-harness
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
