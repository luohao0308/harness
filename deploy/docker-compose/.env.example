APP_ENV=production
# Compose-private handoff defaults. Copy this file to deploy/docker-compose/.env.
# Configure the platform-managed AI provider here. The API key stays server-side
# and must never be copied to browser/VITE/NEXT_PUBLIC environment variables.
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_harness
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent_harness
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://api-server:8000

# ---- AUTH (required) ----
# Generate startup secrets with: python3 scripts/generate-runtime-secrets.py
# Replace these placeholders before starting any API container.
AUTH_JWT_SECRET=replace-with-openssl-rand-hex-32
AUTH_PUBLIC_REGISTRATION_ENABLED=false
HARNESS_SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key
HARNESS_SECRET_ENCRYPTION_KEY_ID=primary-v1

# First-run admin bootstrap. Used only when the users table is empty.
# Remove or clear these after the first successful login.
HARNESS_INITIAL_ADMIN_EMAIL=
HARNESS_INITIAL_ADMIN_PASSWORD=

# ---- AUDIT (required for production) ----
# If APP_ENV=production but AUTH_JWT_SECRET is missing, too short, or still
# uses the example placeholder, startup refuses to boot. Production secret-vault
# reads/writes also require HARNESS_SECRET_ENCRYPTION_KEY.

# Harness currently supports only chat_completions. Production startup requires a real key.
AI_PROVIDER_PROTOCOL=chat_completions
AI_PROVIDER_BASE_URL=https://chybenzun.top/v1
AI_PROVIDER_MODEL=deepseek-v4-flash
AI_PROVIDER_MODELS=deepseek-v4-flash,deepseek-v4-pro,glm-5.2,kimi-k2.7-code,kimi-k2.6,doubao-seed-2-1-turbo,doubao-seed-2-1-pro,qwen3.7-max,qwen3.7-plus,minimax-m3,step-3.7-flash,mimo-v2.5
AI_PROVIDER_NAME=chybenzun-openai-compatible
# Required because this Compose handoff defaults APP_ENV to production.
AI_PROVIDER_API_KEY=

# Legacy local mock compatibility only. Platform AI configuration above is the product default.
MODEL_GATEWAY_BASE_URL=http://api-server:8000/mock-model
MODEL_GATEWAY_API_KEY=replace-me
DEEPSEEK_API_KEY=
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_CONSOLE_BASE_URL=http://127.0.0.1:5173
PUBLIC_WEBSITE_BASE_URL=http://127.0.0.1:3000
API_HTTP_PORT=8000
CONSOLE_HTTP_PORT=5173
WEBSITE_HTTP_PORT=3000
NGINX_HTTP_PORT=8080
PROMETHEUS_PORT=9091
GRAFANA_HTTP_PORT=3001
LOKI_HTTP_PORT=3100
TEMPO_HTTP_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Production profile required values for ../../compose.production.yml.
# Set these explicitly before starting the production stack.
HARNESS_DOMAIN=localhost
HARNESS_EMAIL=admin@example.invalid
HTTP_PORT=80
HTTPS_PORT=443
REDIS_PASSWORD=change-me-redis
BACKUP_DIR=./backups
RCLONE_REMOTE=
