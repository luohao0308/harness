APP_ENV=production
# Compose-private handoff defaults. Copy this file to deploy/docker-compose/.env.
# Leave DEEPSEEK_API_KEY empty for local mock-model fallback validation.
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_harness
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent_harness
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://api-server:8000

# ---- AUTH (required) ----
# JWT signing secret. Generate with: openssl rand -hex 32
# Replace this placeholder before starting any API container.
AUTH_JWT_SECRET=replace-with-openssl-rand-hex-32

# First-run admin bootstrap. Used only when the users table is empty.
# Remove or clear these after the first successful login.
HARNESS_INITIAL_ADMIN_EMAIL=
HARNESS_INITIAL_ADMIN_PASSWORD=

# ---- AUDIT (required for production) ----
# If APP_ENV=production but AUTH_JWT_SECRET is missing, too short, or still
# uses the example placeholder, startup refuses to boot.

MODEL_GATEWAY_BASE_URL=http://api-server:8000/mock-model
MODEL_GATEWAY_API_KEY=replace-me
DEEPSEEK_API_KEY=
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_CONSOLE_BASE_URL=http://127.0.0.1:5173
PUBLIC_WEBSITE_BASE_URL=http://127.0.0.1:3000
API_HTTP_PORT=8000
CONSOLE_HTTP_PORT=5173
WEBSITE_HTTP_PORT=3000
NGINX_HTTP_PORT=8080
PROMETHEUS_PORT=9091
GRAFANA_HTTP_PORT=3001
LOKI_HTTP_PORT=3100
TEMPO_HTTP_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Production profile required values for ../../compose.production.yml.
# Set these explicitly before starting the production stack.
HARNESS_DOMAIN=localhost
HARNESS_EMAIL=admin@example.invalid
HTTP_PORT=80
HTTPS_PORT=443
REDIS_PASSWORD=change-me-redis
BACKUP_DIR=./backups
RCLONE_REMOTE=
