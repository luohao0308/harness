APP_ENV=development
# Host-local defaults for services run outside Docker Compose.
# For the private Docker Compose handoff, copy deploy/docker-compose/.env.example instead.
APP_BASE_URL=http://localhost:3000
CONSOLE_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
NGINX_HTTP_PORT=8080
PROMETHEUS_PORT=9091
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_harness
REDIS_URL=redis://localhost:6379/0

# ---- AUTH (required) ----
# Generate startup secrets with: python3 scripts/generate-runtime-secrets.py
# Replace these placeholders before starting the API.
AUTH_JWT_SECRET=replace-with-openssl-rand-hex-32
AUTH_PUBLIC_REGISTRATION_ENABLED=true
HARNESS_SECRET_ENCRYPTION_KEY=replace-with-generated-fernet-key
HARNESS_SECRET_ENCRYPTION_KEY_ID=primary-v1

# First-run admin bootstrap. Used only when the users table is empty.
# Remove or clear these after the first successful login.
HARNESS_INITIAL_ADMIN_EMAIL=
HARNESS_INITIAL_ADMIN_PASSWORD=

MODEL_GATEWAY_BASE_URL=http://localhost:8000/mock-model
MODEL_GATEWAY_API_KEY=replace-me
DEEPSEEK_API_KEY=
DOCKER_HOST=unix:///var/run/docker.sock
