{
  "name": "@harness/mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "build:ios:beta": "eas build --platform ios --profile beta",
    "build:android:beta": "eas build --platform android --profile beta",
    "submit:ios:beta": "eas submit --platform ios --profile beta",
    "submit:android:beta": "eas submit --platform android --profile beta",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:android:production": "eas build --platform android --profile production",
    "submit:ios:production": "eas submit --platform ios --profile production",
    "submit:android:production": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@shopify/flash-list": "^2.3.2",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "^56.0.12",
    "expo-application": "^56.0.3",
    "expo-background-task": "^56.0.19",
    "expo-constants": "^56.0.18",
    "expo-dev-client": "^56.0.20",
    "expo-device": "^56.0.4",
    "expo-notifications": "^56.0.18",
    "expo-secure-store": "^56.0.4",
    "expo-sqlite": "^56.0.5",
    "expo-status-bar": "^56.0.4",
    "expo-task-manager": "^56.0.19",
    "expo-widgets": "^56.0.19",
    "lucide-react-native": "^1.21.0",
    "react": "^19.2.3",
    "react-native": "^0.86.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
