# Host-local console defaults. Local Vite dev proxies same-origin /api to
# HARNESS_API_PROXY_TARGET (default http://127.0.0.1:8000).
VITE_CONSOLE_BASE_URL=http://127.0.0.1:5173
VITE_API_BASE_URL=/
# Packaged Desktop and its browser Web Extension set this to `local`.
# Enterprise/browser deployments leave it unset or use `enterprise`.
VITE_RUNTIME_PROFILE=enterprise
VITE_DEV_BEARER_TOKEN=dev-engineer-token
VITE_DEV_ADMIN_BEARER_TOKEN=dev-admin-token

# Enterprise terminal WebSocket URL. Local runtime builds ignore this value and
# derive ws(s)://<current-runtime-origin>/ws/terminal, preserving the random port.
VITE_TERMINAL_WS_URL=ws://localhost:8000/ws/terminal
